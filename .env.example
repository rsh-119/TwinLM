GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=

OLLAMA_BASE_URL=http://localhost:11434

DEFAULT_MODEL=auto

DATABASE_URL=sqlite:///./llm_gateway.db

GATEWAY_CONFIG_PATH=gateway.toml
USAGE_SPOOL_PATH=./data/usage-spool.db
# PostgreSQL: persistent pool size; password file used when DATABASE_URL has none
DB_POOL_SIZE=20
# DATABASE_PASSWORD_FILE=/run/secrets/postgres_password
# seconds a validated API key is reused without a database lookup
AUTH_CACHE_SECONDS=30
MAX_CONCURRENT_REQUESTS=100

# API keys are required by default, so ADMIN_TOKEN must be set (it's how
# keys get created; startup fails without it). For a private single-user
# setup use AUTH_ENABLED=false and, for the login-less browser UI,
# WEB_UI_ENABLED=true.
AUTH_ENABLED=true
ADMIN_TOKEN=
# Encrypts provider API keys added from the admin console (any long random
# string; Compose generates one). Changing it makes stored keys unreadable.
PROVIDER_KEYS_SECRET=
WEB_UI_ENABLED=false
# Budget alerts (80% / 100%) are POSTed here as JSON with a Slack-style
# "text" field (Slack/Teams/Discord-compatible incoming webhook). Optional.
BUDGET_ALERT_WEBHOOK_URL=
# Several gateway instances behind a load balancer: shared rate limits,
# response cache, budget reservations, key revocation and console config
# changes. Redis 6.2+. Empty = in-process (one instance).
REDIS_URL=

# Gateway-owned conversations/memories. false = stateless proxy only.
STATEFUL_ENABLED=true
# Shared-user deployments: only user-bound API keys (POST /admin/keys with
# user_id) may use conversations/memories; service keys get 403.
STATEFUL_REQUIRES_USER_KEYS=false
# false = refuse to start on an outdated schema; run `python -m app.ops migrate`.
MIGRATE_ON_STARTUP=true

LOG_FORMAT=json
LOG_LEVEL=INFO

# docker compose only (all optional - secrets are generated automatically)
# GATEWAY_CONFIG_FILE=./loadtest/gateway.mock.toml   # use mock providers (no keys needed)
# GATEWAY_PORT=8000
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3001
# ingress profile (deploy/Caddyfile): real DNS names get Let's Encrypt TLS
# TWINLM_DOMAIN=api.example.com
# CONSOLE_DOMAIN=console.example.com
# GRAFANA_DOMAIN=grafana.example.com
# CONSOLE_USER=operator
